// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette
{
  "session": {
    "trust_all_worktrees": true
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    }
  },
  "preferred_line_length": 200,
  "cli_default_open_behavior": "new_window",
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "disable_ai": false,
  "use_system_prompts": true,
  "icon_theme": "JetBrains New UI Icons (Dark)",
  "vim_mode": false,
  "edit_predictions": {
    "provider": "zed",
    "disabled_globs": [
      ".env",
      "translated_string.py",
      "generate_dataclass.py",
      "examples/main.py"
    ]
  },
  "show_edit_predictions": true,
  "agent": {
    "tool_permissions": {
      "default": "allow"
    },
    "dock": "right",
    "inline_assistant_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4-6"
    },
    "default_model": {
      "effort": "medium",
      "enable_thinking": true,
      "provider": "zed.dev",
      "model": "claude-sonnet-4-6"
    }
  },
  "project_panel": {
    "dock": "left",
    "auto_fold_dirs": false
  },
  "base_keymap": "VSCode",
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "ui_font_size": 16,
  "buffer_font_features": {
    "calt": false
  },
  "buffer_font_size": null,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Catppuccin Macchiato"
  },
  "languages": {
    "Plain Text": {
      "show_edit_predictions": true
    },
    "YAML": {
      "show_edit_predictions": true
    },
    "CSS": {
      "show_edit_predictions": true
    },
    "JavaScript": {
      "show_edit_predictions": true
    },
    "HTML": {
      "show_edit_predictions": true
    },
    "Python": {
      "language_servers": ["ruff", "pyright"],
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "ruff"
        }
      },
      "code_actions_on_format": {
        "source.fixAll.ruff": true,
        "source.organizeImports.ruff": true
      }
    },
    "Rust": {
      "format_on_save": "off"
    }
  },
  "lsp": {
    "ruff": {
      "initialization_options": {
        "settings": {
          "lineLength": 120
        }
      }
    },
    "pyright": {
      "settings": {
        "python.analysis": {
          "typeCheckingMode": "basic"
        }
      }
    }
  }
}
